<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:gravity="center"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="48dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_download"
        android:tint="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="Receber APK"
        android:textColor="@color/text_primary"
        android:textSize="30sp" />

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="No celular ou PC, conectado no mesmo Wi-Fi, abra no navegador:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/pill_bg"
        android:fontFamily="monospace"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:textColor="@color/accent"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/permission_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Primeiro, permita que o HY Home instale apps"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/allow_button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Permitir instalação"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Aperte Voltar para sair"
        android:textSize="14sp" />
</LinearLayout>
